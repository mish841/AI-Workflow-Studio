OPENAI_API_KEY=replace-me
DATABASE_URL=postgresql://USER@localhost:5432/ai_workflow_studio
# User-facing assessments use evaluation_mode=auto (prefer retrieved passages).
# Full-document fallback is off unless this is true. Engineering clients may still POST direct or rag.
COMPLIANCE_ALLOW_DIRECT_FALLBACK=false
# Paid OpenAI chat/embedding calls. Keep true for local demos. Set false if this API is reachable beyond localhost.
PAID_OPENAI_ENABLED=true
